# Cổng Docker trên máy chủ (sửa DATABASE_URL tương ứng nếu dùng 5433)
POSTGRES_PORT=5432
DATA_LAKE_DIR=data
DATABASE_URL=postgresql://recommender:change-me@127.0.0.1:5432/recommender
API_BASE_URL=http://127.0.0.1:8000
RANDOM_SEED=42

# Kho lưu trữ đối tượng MinIO tương thích S3
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_CONSOLE_URL=http://127.0.0.1:9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
DATA_LAKE_STORAGE=minio

# Truyền luồng sự kiện bằng Apache Kafka
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC_EVENTS=product-events
